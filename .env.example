# Public PocketBase proxy path used by the browser.
PUBLIC_POCKETBASE_URL=/api/db

# Server-side PocketBase endpoint.
POCKETBASE_URL=

# Random session secret for the server.
SESSION_SECRET=

# Server-only PocketBase service credentials.
PB_ADMIN_EMAIL=
PB_ADMIN_PASSWORD=

# KMITL IAM settings.
CLIENT_SECRET=
PUBLIC_KMITL_CLIENT_ID=
PUBLIC_KMITL_REDIRECT_URI=
PUBLIC_IAM_REDIRECT_URI=

# Set true only behind a trusted reverse proxy that overwrites client IP headers.
TRUST_PROXY=false
